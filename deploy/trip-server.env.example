# /etc/trip-journal.env — read by trip-journal.service (install with: chmod 600, owner root).
# Placeholders only. Every variable can also be passed as a command-line flag; see
# `python3 server/trip_server.py --help` and server/README.md.

# Public origin exactly as the app sends it in the Origin header: scheme://host[:port], no path.
# Writes whose Origin differs are rejected (403). Session cookies get "Secure" when this is https.
TRIP_ORIGIN=https://trip.example.com

# Cookie path: the reverse-proxy prefix the app talks to (see deploy/nginx-location.example.conf).
# Use a long random path segment, e.g. /onetrip/<output of: openssl rand -base64 18 | tr '+/' '-_'>/
TRIP_COOKIE_PATH=/onetrip/REPLACE-WITH-RANDOM-PATH/

# SHA-256 (lowercase hex) of the app's shared access key (the TripSharedAccessKey the iOS build
# embeds, 32-256 characters). Only the hash lives on the server. Generate a key and its hash with:
#   key=$(openssl rand -base64 36 | tr '+/' '-_' | tr -d '=')
#   printf %s "$key" | shasum -a 256        # macOS  (Linux: sha256sum)
# Put "$key" in ios/SharedAccess.xcconfig and the 64-character hash here. Empty = sharing disabled (503).
TRIP_NATIVE_KEY_SHA256=

# Generated catalog (scripts/build_ios_resources.py -> ios/TripJournal/Resources/Content/catalog.json),
# copied to the server. Its trip.id must equal the id stored in the database by `init`.
TRIP_CATALOG=/opt/trip-journal/catalog.json

# Optional overrides (defaults shown). systemd does not allow trailing comments on a value line.
# Loopback port; the server only ever binds 127.0.0.1.
#TRIP_PORT=8765
# Database directory (the unit also passes --data-dir explicitly).
#TRIP_DATA_DIR=/var/lib/trip-journal
# Session cookie name; must match what the iOS app expects.
#TRIP_COOKIE_NAME=trip_session
# Route bounds override as minLat,maxLat,minLon,maxLon; default: catalog trip.map.bounds.
#TRIP_MAP_BOUNDS=

# Optional isolated App Review database (created with `trip_server.py init --db <path>`), opened only
# by a second, different access key. Leave both empty to disable.
#TRIP_REVIEW_DB=/var/lib/trip-journal/review.sqlite3
#TRIP_REVIEW_KEY_SHA256=

# Optional routing (Valhalla artifact installed by deploy/install_route_artifact.py).
# Individual paths default to <TRIP_ROUTE_ROOT>/valhalla/bin/valhalla_service, /valhalla.json, /places.json.
#TRIP_ROUTE_ROOT=/opt/trip-journal/routes/current
#TRIP_ROUTE_BINARY=
#TRIP_ROUTE_CONFIG=
#TRIP_ROUTE_PLACES=
# Set to 1 only after every phone runs an app version that understands englishAddress route entries.
TRIP_ROUTE_ENGLISH_ADDRESS_SHARING=0
