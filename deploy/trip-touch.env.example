# /etc/trip-journal-touch.env — read by trip-journal-touch-push.service only (chmod 600).
# Placeholders only. The APNs worker needs these four; the HTTP server does not read them.

# Apple Developer Team ID (10 characters, Membership details page).
TOUCH_APNS_TEAM_ID=ABCDE12345
# Key ID of an APNs authentication key (Certificates, Identifiers & Profiles > Keys).
TOUCH_APNS_KEY_ID=KEY1234567
# Path to that key's .p8 file, readable by the trip-journal user only. Never commit it.
TOUCH_APNS_KEY_PATH=/etc/trip-journal/AuthKey_KEY1234567.p8
# The app's bundle identifier (the APNs topic). Required; there is no default.
TOUCH_APNS_TOPIC=com.example.tripjournal
